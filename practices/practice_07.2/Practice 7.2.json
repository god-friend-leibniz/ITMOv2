        "jsCode": "const result = $json.text ?? $json.output ?? $json;\n\nconst confident = typeof result.confidence === 'number'\n  && result.confidence >= 0.8\n  && result.confidence <= 1;\n\nconst knownType = ['bug', 'task', 'feature'].includes(result.type);\n\nreturn {\n  json: {\n    ...$('Prepare Issue').item.json,\n    type: confident && knownType ? result.type : 'unknown',\n    confidence: result.confidence,\n  },\n};"

    {
      "parameters": {
        "jsCode": "const blocks = [];\nconst files = $input.all();\n\nfor (const [fileIndex, item] of files.entries()) {\n  const file = item.json;\n\n  if (typeof file.patch !== 'string') {\n    continue;\n  }\n\n  let block = null;\n\n  for (const text of file.patch.split(/\\r?\\n/)) {\n    const header = text.match(\n      /^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@/\n    );\n\n    if (header) {\n      const newCount = Number(header[4] ?? 1);\n      const side = newCount > 0 ? 'RIGHT' : 'LEFT';\n      const start = Number(side === 'RIGHT' ? header[3] : header[1]);\n      const count = side === 'RIGHT' ? newCount : Number(header[2] ?? 1);\n\n      block = {\n        path: file.filename,\n        patch: text,\n        start_line: start,\n        start_side: side,\n        line: start + count - 1,\n        side,\n      };\n\n      blocks.push({ json: block, pairedItem: { item: fileIndex } });\n    } else if (block) {\n      block.patch += '\\n' + text;\n    }\n  }\n}\n\nreturn blocks;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        304
      ],
      "id": "2113c109-b318-4a48-ba95-ea4e008bc733",
      "name": "Prepare Review Blocks"

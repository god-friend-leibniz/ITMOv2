      "id": "f8bfffea-db7d-4787-b900-a82b13fd8ccd",
      "name": "Claude Sonnet",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        864,
        704
      ],
      "typeVersion": 1.2,
      "credentials": {

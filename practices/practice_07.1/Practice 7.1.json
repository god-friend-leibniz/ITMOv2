    {
      "parameters": {
        "jsCode": "const pr = $('Get PR Info').first().json;\n\nif (!pr.head?.sha) {\n  throw new Error('Get PR Info must return JSON containing head.sha.');\n}\n\nconst comments = $input.all().map(item => {\n  const block = item.json;\n  const comment = {\n    path: block.path,\n    body: block.body,\n    line: block.line,\n    side: block.side,\n  };\n\n  if (block.start_line < block.line) {\n    comment.start_line = block.start_line;\n    comment.start_side = block.start_side;\n  }\n\n  return comment;\n});\n\nconst command = ($('PR Trigger').first().json.body.comment?.body ?? '').trim();\n\nconst reviewBody = command === '/make_other_ai_review'\n  ? 'AI-ревью другой моделью — Claude Sonnet 4.6.'\n  : 'AI-ревью изменённых блоков кода.';\n\nreturn [{\n  json: {\n    commit_id: pr.head.sha,\n    event: 'COMMENT',\n    body: reviewBody,\n    comments,\n  },\n}];\n"
      },
